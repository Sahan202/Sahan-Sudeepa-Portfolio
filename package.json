{
  "name": "portfolio-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "next build",
    "build:ts": "next typegen && tsc --noEmit",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next start",
    "prepare": "husky install",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "pre-commit": "lint-staged && yarn build:ts",
    "pre-push": "yarn build:check",
    "validate": "yarn format && yarn lint && yarn build:check",
    "validate:fix": "yarn format:write && yarn lint:fix && yarn build:check",
    "start": "next start",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^0.513.0",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "three": "^0.186.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "~5.7.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=20.9.0"
  }
}
