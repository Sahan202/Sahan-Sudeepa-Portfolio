# Public site URL, including https://. Set this to your actual deployment domain.
NEXT_PUBLIC_SITE_URL=https://sahan-sudeepa-portfolio.netlify.app
# Optional public email address (shown in the site and mailto links).
NEXT_PUBLIC_CONTACT_EMAIL=sahansudeepa589@gmail.com
# EmailJS delivery (server-only). Copy this file to .env.local.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Server-only delivery endpoint. POST receives {name, email, message} JSON.
# Must return a 2xx status only after accepting the message for delivery.
CONTACT_WEBHOOK_URL=
# Optional server-only bearer token for the delivery endpoint.
CONTACT_WEBHOOK_TOKEN=
